#!/bin/bash
# dns-update — update an existing A record and its PTR in BIND9
# Usage: dns-update <hostname> <new-ip> [zone]
# If [zone] is omitted: auto-picked if only one zone exists, otherwise prompted.

set -euo pipefail
source /usr/local/bin/dns-common.sh

[ "$EUID" -ne 0 ] && { error "Run as root."; exit 1; }
if [ "$#" -lt 2 ] || [ "$#" -gt 3 ]; then
  echo "Usage: dns-update <hostname> <new-ip> [zone]"
  exit 1
fi

HOST="$1"
NEW_IP="$2"
ZONE_ARG="${3:-}"

if ! [[ "$NEW_IP" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
  error "Invalid IP: $NEW_IP"
  exit 1
fi

ZONE=$(select_zone "$ZONE_ARG")
FORWARD_ZONE=$(zone_file_for "$ZONE")
[ -z "$FORWARD_ZONE" ] && { error "Could not resolve zone file for $ZONE in $NAMED_CONF_LOCAL."; exit 1; }

if ! grep -q "^${HOST}[[:space:]]" "$FORWARD_ZONE"; then
  warn "$HOST not found in $ZONE. Use dns-add instead."
  exit 1
fi

if grep -q "^${HOST}[[:space:]]\+IN[[:space:]]\+CNAME" "$FORWARD_ZONE"; then
  error "$HOST is a CNAME record. Use dns-update-cname instead."
  exit 1
fi

OLD_IP=$(grep "^${HOST}[[:space:]]" "$FORWARD_ZONE" | awk '{print $NF}')
sed -i "s/^${HOST}[[:space:]].*$/${HOST}     IN  A   ${NEW_IP}/" "$FORWARD_ZONE"
info "Updated A record: ${HOST}.${ZONE} -> ${NEW_IP}"

OLD_REVERSE_ZONE_FILE=$(get_reverse_zone_file_for_ip "$OLD_IP")
if [ -n "$OLD_REVERSE_ZONE_FILE" ]; then
  OLD_LAST=$(echo "$OLD_IP" | cut -d'.' -f4)
  sed -i "/^${OLD_LAST}[[:space:]]/d" "$OLD_REVERSE_ZONE_FILE"
  info "Removed old PTR: ${OLD_LAST}"
fi

NEW_REVERSE_ZONE_FILE=$(get_reverse_zone_file_for_ip "$NEW_IP")
if [ -n "$NEW_REVERSE_ZONE_FILE" ]; then
  NEW_LAST=$(echo "$NEW_IP" | cut -d'.' -f4)
  echo "${NEW_LAST}    IN  PTR ${HOST}.${ZONE}." >> "$NEW_REVERSE_ZONE_FILE"
  info "Added new PTR: ${NEW_LAST} -> ${HOST}.${ZONE}"
fi

SERIAL=$(date +%Y%m%d%H)
sed -i "s/[0-9]\{10\}.*; Serial/${SERIAL}        ; Serial/" "$FORWARD_ZONE"

REVERSE_FILES_TO_BUMP=()
[ -n "$OLD_REVERSE_ZONE_FILE" ] && REVERSE_FILES_TO_BUMP+=("$OLD_REVERSE_ZONE_FILE")
if [ -n "$NEW_REVERSE_ZONE_FILE" ] && [ "$NEW_REVERSE_ZONE_FILE" != "$OLD_REVERSE_ZONE_FILE" ]; then
  REVERSE_FILES_TO_BUMP+=("$NEW_REVERSE_ZONE_FILE")
fi
for f in "${REVERSE_FILES_TO_BUMP[@]:-}"; do
  [ -n "$f" ] && sed -i "s/[0-9]\{10\}.*; Serial/${SERIAL}        ; Serial/" "$f"
done

named-checkzone "$ZONE" "$FORWARD_ZONE" > /dev/null || { error "Zone validation failed."; exit 1; }
rndc reload > /dev/null
info "BIND9 reloaded."
