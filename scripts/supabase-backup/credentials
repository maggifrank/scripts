#!/bin/bash
# credentials — rotate a project's credentials, from a request the console left.
#
#   credentials --drain          process every pending request (what the .path unit runs)
#   credentials <request.json>   process one
#
# Runs as root, triggered by supabase-backup-credentials.path. It edits one
# file: /etc/supabase-backup/<project>.conf, and only the three fields that are
# credentials. BACKUP_DIR, KEEP_DAYS and anything else in there are left alone.
#
# Rotating used to mean editing that file over SSH, which is why nobody did it.
# A credential that is never rotated is one whose exposure window is "since it
# was created", and on a host holding a service key that is the whole risk.
#
# The request is written by a network-facing process, so nothing in it is
# trusted: every field is validated again here, the new credentials are proved
# to work *before* anything is written, and the file is shredded as soon as it
# has been read - it holds a database password and a service key until then.
set -euo pipefail

export LC_ALL=C.UTF-8 LANG=C.UTF-8

CONF_DIR="${CONF_DIR:-/etc/supabase-backup}"
SPOOL_DIR="${SPOOL_DIR:-/run/supabase-backup-web}"
REQ_DIR="${SPOOL_DIR}/credentials"
RES_DIR="${SPOOL_DIR}/results"
WEB_USER="${WEB_USER:-supabase-backup-web}"

STEPS=()
note() { STEPS+=("$1"); printf '  %s\n' "$1"; }

emit() {  # emit <id> <state> <error>
  local id="$1" state="$2" error="${3:-}"
  mkdir -p "$RES_DIR"
  jq -nc --arg id "$id" --arg state "$state" --arg error "$error" \
     --arg finished "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
     --argjson steps "$(printf '%s\n' "${STEPS[@]:-}" | jq -R -s 'split("\n") | map(select(length>0))')" \
     '{kind:"credentials", id:$id, state:$state, error:$error, steps:$steps, finished_at:$finished}' \
     > "${RES_DIR}/${id}.json.tmp"
  chmod 0640 "${RES_DIR}/${id}.json.tmp"
  chgrp "$WEB_USER" "${RES_DIR}/${id}.json.tmp" 2>/dev/null || true
  mv -f "${RES_DIR}/${id}.json.tmp" "${RES_DIR}/${id}.json"
}

ref_of() { sed -E 's|.*://(postgres\.)?([a-z0-9-]+)[.:/].*|\2|; s|/+$||' <<<"$1"; }

# The value currently in the file, for a field the request did not carry. A
# rotation is usually one credential, not all three, and making someone re-type
# the two that did not change is how a rotation turns into a typo.
conf_value() {  # conf_value <file> <key>
  sed -n "s/^$2=//p" "$1" | head -1
}

# What a credential can do, which is the thing worth knowing about it and the
# thing nobody checks. A backup only ever reads: it runs pg_dump, psql selects
# and catalog queries, and writes nothing to the source. A role that can also
# write is a role that can destroy the project it is protecting, from a file
# sitting on a host, and the operator should hear that said out loud.
report_privilege() {  # report_privilege <database_url>
  local url="$1" writable total
  writable="$(psql "$url" -Atqc "
    select count(*) from pg_class c
      join pg_namespace n on n.oid = c.relnamespace
     where c.relkind in ('r','p') and n.nspname = 'public'
       and has_table_privilege(current_user, c.oid, 'INSERT, UPDATE, DELETE, TRUNCATE')
  " 2>/dev/null)" || return 0
  total="$(psql "$url" -Atqc "
    select count(*) from pg_class c
      join pg_namespace n on n.oid = c.relnamespace
     where c.relkind in ('r','p') and n.nspname = 'public'
  " 2>/dev/null)" || return 0
  [[ "$writable" =~ ^[0-9]+$ && "$total" =~ ^[0-9]+$ ]] || return 0

  if [ "$writable" -eq 0 ]; then
    note "this role cannot write to any table in public - a stolen copy of it cannot destroy the project"
  else
    note "this role can write to ${writable} of ${total} table(s) in public, and the backup only ever reads. A read-only role would mean a stolen copy could not destroy the project - see the docs."
  fi
}

process() {
  local file="$1"
  STEPS=()

  local id
  id="$(basename "$file" .json)"
  [[ "$id" =~ ^[0-9a-f]{32}$ ]] || { rm -f "$file"; return 0; }

  # Read the whole request, then destroy it. Everything after this works from
  # memory, so a crash cannot leave a service key sitting in /run.
  local body project conf
  body="$(cat "$file")" || { emit "$id" failed "could not read the request"; rm -f "$file"; return 0; }
  shred -u "$file" 2>/dev/null || rm -f "$file"

  project="$(jq -r '.project // empty' <<<"$body")"
  [[ "$project" =~ ^[a-z0-9][a-z0-9_-]{0,62}$ ]] \
    || { emit "$id" failed "invalid project name"; return 0; }
  conf="${CONF_DIR}/${project}.conf"
  [ -f "$conf" ] \
    || { emit "$id" failed "no project named '${project}' is configured on this host"; return 0; }

  # Absent means "leave this one alone", so a rotation can be one credential.
  local database_url supabase_url service_key changed=()
  database_url="$(jq -r '.database_url // empty' <<<"$body")"
  supabase_url="$(jq -r '.supabase_url // empty'  <<<"$body")"
  service_key="$(jq -r '.service_key // empty'    <<<"$body")"
  [ -n "$database_url" ] && changed+=("database URI")
  [ -n "$supabase_url" ]  && changed+=("project URL")
  [ -n "$service_key" ]   && changed+=("service key")
  if [ ${#changed[@]} -eq 0 ]; then
    emit "$id" failed "the request changed nothing"
    return 0
  fi
  [ -z "$database_url" ] && database_url="$(conf_value "$conf" DATABASE_URL)"
  [ -z "$supabase_url" ]  && supabase_url="$(conf_value "$conf" SUPABASE_URL)"
  [ -z "$service_key" ]   && service_key="$(conf_value "$conf" SUPABASE_SERVICE_KEY)"
  body=""

  # ── Validate, trusting nothing the console sent ──
  [[ "$database_url" =~ ^postgres(ql)?:// ]] \
    || { emit "$id" failed "DATABASE_URL is not a postgresql:// URI"; return 0; }
  [[ "$supabase_url" =~ ^https://[a-z0-9-]+\.supabase\.(co|com)$ ]] \
    || { emit "$id" failed "project URL is not https://<ref>.supabase.co"; return 0; }
  [ -n "$service_key" ] || { emit "$id" failed "no service key"; return 0; }
  note "rotating: $(IFS=', '; echo "${changed[*]}")"

  local db_ref url_ref
  db_ref="$(ref_of "$database_url")"; url_ref="$(ref_of "$supabase_url")"
  [ "$db_ref" = "$url_ref" ] \
    || { emit "$id" failed "credentials disagree: the database URI names '${db_ref}', the project URL names '${url_ref}'"; return 0; }

  # The project must not change under a rotation. Pointing an existing config
  # at a different project would keep its archive directory and its history
  # while silently backing up something else.
  local old_ref
  old_ref="$(ref_of "$(conf_value "$conf" SUPABASE_URL)")"
  [ -z "$old_ref" ] || [ "$old_ref" = "$url_ref" ] \
    || { emit "$id" failed "'${project}' backs up '${old_ref}' and these credentials name '${url_ref}'. Rotating a credential cannot repoint a project - register a new one instead."; return 0; }
  note "still project '${url_ref}'"

  # ── Prove they work before replacing anything ──
  # The whole point of doing this here rather than by hand is that a rotation
  # into a typo is a config that looks fine and a timer that fails at 03:20.
  local err server_ver
  err="$(mktemp)"
  if ! server_ver="$(psql "$database_url" -Atc 'show server_version_num' 2>"$err")"; then
    local detail; detail="$(head -3 "$err" | tr '\n' ' ')"; rm -f "$err"
    emit "$id" failed "the new credentials cannot reach Postgres: ${detail}. Nothing was changed."
    return 0
  fi
  rm -f "$err"
  note "connected to Postgres (server_version_num ${server_ver})"

  local code
  code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 20 \
        "${supabase_url}/storage/v1/bucket" \
        -H "Authorization: Bearer ${service_key}" -H "apikey: ${service_key}")"
  [ "$code" = "200" ] \
    || { emit "$id" failed "the service key was rejected by storage (HTTP ${code}). Nothing was changed."; return 0; }
  note "service key accepted by the storage API"

  report_privilege "$database_url"

  # ── Write, keeping everything that is not a credential ──
  # Rewritten rather than edited in place: an edit that fails partway through
  # leaves a config file that is neither the old one nor the new one.
  local tmp
  umask 077
  tmp="$(mktemp "${conf}.XXXXXX")"
  {
    grep -vE '^(DATABASE_URL|SUPABASE_URL|SUPABASE_SERVICE_KEY)=' "$conf" || true
    printf 'DATABASE_URL=%s\n' "$database_url"
    printf 'SUPABASE_URL=%s\n' "$supabase_url"
    printf 'SUPABASE_SERVICE_KEY=%s\n' "$service_key"
  } > "$tmp"
  chmod 0600 "$tmp"
  mv -f "$tmp" "$conf"
  note "wrote ${conf}, mode 0600, keeping its other settings"
  note "the next run uses these; nothing re-reads the old ones"

  emit "$id" ok ""
}

case "${1:-}" in
  --drain|"")
    shopt -s nullglob
    for f in "$REQ_DIR"/*.json; do process "$f"; done
    ;;
  *) process "$1" ;;
esac
