[Unit]
Description=Rotate a project's credentials from the backup console
Documentation=https://github.com/maggifrank/scripts/blob/main/scripts/docs/supabase-backup-web.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/supabase-backup/credentials --drain

# The privileged half. It rewrites a 0600 config under /etc/supabase-backup -
# which the console cannot even read - and it needs the network, because it
# proves the new credentials work against Postgres and the storage API before
# replacing the ones that do.
ReadWritePaths=/etc/supabase-backup /run/supabase-backup-web
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
