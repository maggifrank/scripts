[Unit]
Description=Watch for credential rotations from the backup console
Documentation=https://github.com/maggifrank/scripts/blob/main/scripts/docs/supabase-backup-web.md

[Path]
# The console drops a request here; this fires the root oneshot that applies it.
# The console cannot read a project's credentials and cannot write them - it
# only carries the new ones as far as this directory.
DirectoryNotEmpty=/run/supabase-backup-web/credentials
MakeDirectory=false

[Install]
WantedBy=paths.target
