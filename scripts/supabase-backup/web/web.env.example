# Configuration for supabase-backup-web.
# /etc/supabase-backup-web/web.env, mode 0640 root:supabase-backup-web.
#
# Deliberately not in /etc/supabase-backup: that directory holds the per-project
# database passwords and service keys, and this process must never be able to
# read one. Keeping the two apart is what makes that easy to check.

# Where to listen. 127.0.0.1 means "reachable only through an SSH tunnel or a
# reverse proxy on this host". Use 0.0.0.0 to serve the LAN directly - but Basic
# auth over plain HTTP puts the password on the wire. See the docs.
WEB_BIND=127.0.0.1:8787

# Credentials. Generate the hash with:
#   /opt/supabase-backup/web/server.py --hash
# The console's Settings panel can change both of these for you: it hashes the
# new password itself and hands the digest to a root helper, which writes it
# here and restarts the service.
WEB_USER=admin
WEB_PASSWORD_HASH=

# Allow the per-project "Run backup now" button. Needs the polkit rule the
# setup script installs; without it the button is there and every click fails.
WEB_ALLOW_RUN=1

# Allow downloading whole archives over HTTP. Off by default: an archive holds
# every auth password hash and every storage object. scp is the better route
# for a one-off.
WEB_ALLOW_DOWNLOAD=0

# Allow restoring an archive from the console. Off by default, and it is the
# one switch here worth thinking about before flipping: a restore writes into a
# live project and cannot be taken back. With it on, the console can only ask -
# /opt/supabase-backup/restore does the work as root, refuses any project this
# host backs up, and requires the target ref typed out in the form.
WEB_ALLOW_RESTORE=0

# How old a project's newest archive may be before it is called stale. The
# timer fires at 03:20 with up to 20 minutes of jitter, so past ~26h means a
# night was missed.
WEB_STALE_HOURS=26

# Allow the Settings panel to change this file at all. Turning it off makes the
# console read-only about itself; turning it back on means editing this file on
# the host, which is rather the point of the switch.
WEB_ALLOW_SETTINGS=1

# Free-space forecast. The console samples free space on this interval and fits
# a line through what it saw, averaging away the retention sawtooth first - so
# it takes two prune cycles before it will answer confidently, and it says so
# in the meantime rather than reading one falling edge as a runaway.
#WEB_SAMPLE_SECONDS=3600
#WEB_HISTORY_DAYS=90
#WEB_FORECAST_DAYS=30
#WEB_FORECAST_MIN_DAYS=3
#WEB_STATE_DIR=/var/lib/supabase-backup-web

#DATA_DIR=/var/backups/supabase
#UNIT_PREFIX=supabase-backup
#WEB_RUN_COMMAND=systemctl start --no-block {unit}
