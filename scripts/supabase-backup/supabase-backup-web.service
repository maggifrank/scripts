[Unit]
Description=Supabase backup web console
Documentation=https://github.com/maggifrank/scripts/blob/main/scripts/docs/supabase-backup-web.md
After=network.target

[Service]
Type=exec
User=supabase-backup-web
Group=supabase-backup-web
ExecStart=/opt/supabase-backup/web/server.py
Restart=on-failure
RestartSec=5s

EnvironmentFile=/etc/supabase-backup-web/web.env

# EnvironmentFile= rather than Environment=: systemd expands $ in Environment=
# values, and a PBKDF2 hash is $-separated, so the process would receive a
# mangled hash and silently reject every password. EnvironmentFile does no
# expansion.

# Reading the journal is how the run history is built.
SupplementaryGroups=systemd-journal

# This process has no business reading a project's credentials. The 0600 modes
# on those files already stop it; this makes the intent explicit and survives
# someone loosening them by accident.
InaccessiblePaths=-/etc/supabase-backup

# The only writable paths: the spools where a request is left for a privileged
# helper to pick up - a project to register, a change to this console's own
# settings, who an archive is encrypted to, a restore. Everything else stays
# read-only, /etc/supabase-backup-web included: the console cannot rewrite the
# file that configures it.
ReadWritePaths=/run/supabase-backup-web/register /run/supabase-backup-web/settings /run/supabase-backup-web/encryption /run/supabase-backup-web/restore

# The one thing the console keeps for itself, and the only thing it puts on a
# real disk: an hourly free-space sample, so "when does this fill up" is
# answered from what was observed rather than guessed from today's snapshot.
# systemd creates the directory and hands it over already owned by this user.
# It holds no secret - how much room was left, and when.
StateDirectory=supabase-backup-web
StateDirectoryMode=0750

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
