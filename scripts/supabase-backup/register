#!/bin/bash
# register — apply registration requests left in the console's spool.
#
#   register --drain          process every pending request (what the .path unit runs)
#   register <request.json>   process one
#
# Runs as root, triggered by supabase-backup-register.path when the console
# drops a request. The console itself has no privilege and writes nothing
# outside its own spool directory; everything that touches a credential, a
# root-owned config or a systemd unit happens here.
#
# A request file is written by a network-facing process, so nothing in it is
# trusted: every field is validated again here, and the file is shredded as
# soon as it has been read - it holds a service key until then.
set -euo pipefail

export LC_ALL=C.UTF-8 LANG=C.UTF-8

LIB_DIR="${LIB_DIR:-/opt/supabase-backup}"
CONF_DIR="${CONF_DIR:-/etc/supabase-backup}"
DATA_DIR="${DATA_DIR:-/var/backups/supabase}"
SPOOL_DIR="${SPOOL_DIR:-/run/supabase-backup-web}"
REG_DIR="${SPOOL_DIR}/register"
RES_DIR="${SPOOL_DIR}/results"
WEB_USER="${WEB_USER:-supabase-backup-web}"

STEPS=()
# The console polls for a result and shows "applying" until one appears, so a
# request that is never answered does not read as a failure - it reads as a
# helper that was never installed, which is what the page then says. These two
# exist so that every path out of this script answers, including the ones that
# were never meant to be taken.
CURRENT_ID=""
EMITTED=0

# What this run has built so far, and what undoing it means. A registration is
# all or nothing: a config left behind by a run that died is a project the
# console lists, nothing backs up, and nobody can re-register - the next
# attempt is refused for already existing.
PARTIAL_CONF=""
PARTIAL_DIR=""

note() { STEPS+=("$1"); printf '  %s\n' "$1"; }

undo_partial() {
  local conf="$PARTIAL_CONF" dir="$PARTIAL_DIR"
  PARTIAL_CONF=""; PARTIAL_DIR=""
  # rmdir, not rm -r. If a backup has already written in there this is no
  # longer a half-finished registration, and nothing here should be deleting
  # archives; rmdir refuses and leaves it, which is the right answer.
  [ -n "$dir" ] && rmdir "$dir" 2>/dev/null || true
  [ -n "$conf" ] || return 0
  rm -f "$conf"
  note "removed the half-written config - nothing is registered, so this can be retried"
  # Explicitly. This runs from the EXIT trap, where a non-zero return would
  # abort the trap under set -e and lose the very result it exists to write.
  return 0
}

emit() {  # emit <id> <state> <error>
  local id="$1" state="$2" error="${3:-}"
  mkdir -p "$RES_DIR"
  jq -nc --arg id "$id" --arg state "$state" --arg error "$error" \
     --arg finished "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
     --argjson steps "$(printf '%s\n' "${STEPS[@]:-}" | jq -R -s 'split("\n") | map(select(length>0))')" \
     '{id:$id, state:$state, error:$error, steps:$steps, finished_at:$finished}' \
     > "${RES_DIR}/${id}.json.tmp"
  chmod 0640 "${RES_DIR}/${id}.json.tmp"
  chgrp "$WEB_USER" "${RES_DIR}/${id}.json.tmp" 2>/dev/null || true
  mv -f "${RES_DIR}/${id}.json.tmp" "${RES_DIR}/${id}.json"
  # "running" claims the id, it does not answer it. Counting it as an answer
  # would leave on_exit silent and the console polling a placeholder for ever.
  [ "$state" = "running" ] || EMITTED=1
}

on_exit() {
  # Anything that reached here having read a request and not answered it: a
  # set -e abort, a kill, a systemd timeout. The journal has the detail; the
  # console gets told the attempt is over and that nothing was left behind,
  # which is the part it cannot work out for itself. The steps are kept - how
  # far this got is the whole diagnosis.
  [ -n "$CURRENT_ID" ] && [ "$EMITTED" = "0" ] || return 0
  undo_partial
  emit "$CURRENT_ID" failed "the helper stopped without finishing - journalctl -u supabase-backup-register has the reason"
}
trap on_exit EXIT
# An untrapped TERM kills the shell without running the EXIT trap, and a
# systemd timeout or `systemctl stop` is exactly a TERM - the case where the
# console most needs telling. Exiting from the handler is what gets it there.
trap 'exit 143' TERM
trap 'exit 130' INT

ref_of() { sed -E 's|.*://(postgres\.)?([a-z0-9-]+)[.:/].*|\2|; s|/+$||' <<<"$1"; }

process() {
  local file="$1"
  STEPS=()

  local id
  id="$(basename "$file" .json)"
  [[ "$id" =~ ^[0-9a-f]{32}$ ]] || { rm -f "$file"; return 0; }
  # From here on this request is answerable, so on_exit will answer it if
  # nothing below does.
  CURRENT_ID="$id"; EMITTED=0; PARTIAL_CONF=""; PARTIAL_DIR=""

  # Read the whole request, then destroy it. Everything after this point works
  # from memory, so a crash cannot leave a service key sitting in /run.
  local body project database_url supabase_url service_key keep_days run_now
  body="$(cat "$file")" || { emit "$id" failed "could not read the request"; rm -f "$file"; return 0; }
  shred -u "$file" 2>/dev/null || rm -f "$file"

  # The request is gone and there is no result yet. The console reads that gap
  # - no request, no result - as "unknown", and reports it as a helper that was
  # never installed, which is the one thing it cannot be: something shredded
  # the request. The gap is seconds wide and proving the credentials is two
  # round trips to Supabase, so it was wide enough to hit every time. Claim the
  # id now and let the real result overwrite it, the way reconfigure does.
  emit "$id" running ""

  project="$(jq -r '.project // empty'      <<<"$body")"
  database_url="$(jq -r '.database_url // empty' <<<"$body")"
  supabase_url="$(jq -r '.supabase_url // empty' <<<"$body")"
  service_key="$(jq -r '.service_key // empty'   <<<"$body")"
  keep_days="$(jq -r '.keep_days // 30'     <<<"$body")"
  run_now="$(jq -r '.run_now // true'       <<<"$body")"

  # ── Validate, trusting nothing the console sent ──
  [[ "$project" =~ ^[a-z0-9][a-z0-9_-]{0,62}$ ]] \
    || { emit "$id" failed "invalid project name"; return 0; }
  [[ "$database_url" =~ ^postgres(ql)?:// ]] \
    || { emit "$id" failed "DATABASE_URL is not a postgresql:// URI"; return 0; }
  [[ "$supabase_url" =~ ^https://[a-z0-9-]+\.supabase\.(co|com)$ ]] \
    || { emit "$id" failed "project URL is not https://<ref>.supabase.co"; return 0; }
  [[ -n "$service_key" ]] || { emit "$id" failed "no service key"; return 0; }
  # Supabase shows two keys on the same page and only one of them can do this.
  # The publishable key is the browser's: it cannot bypass RLS and cannot list
  # a bucket, so it fails at the storage check a few seconds later with an
  # HTTP code instead of an explanation.
  [[ "$service_key" == sb_publishable_* || "$service_key" == sbp_* ]] \
    && { emit "$id" failed "that is the publishable key. A backup needs the secret key (sb_secret_...), which is the only one that can read every bucket and bypass RLS."; return 0; }
  [[ "$keep_days" =~ ^[0-9]+$ ]] || { emit "$id" failed "keep_days is not a number"; return 0; }
  [ -f "${CONF_DIR}/${project}.conf" ] \
    && { emit "$id" failed "a project named '${project}' is already configured"; return 0; }
  note "request accepted for '${project}'"

  local db_ref url_ref
  db_ref="$(ref_of "$database_url")"; url_ref="$(ref_of "$supabase_url")"
  [ "$db_ref" = "$url_ref" ] \
    || { emit "$id" failed "credentials disagree: database URI names '${db_ref}', project URL names '${url_ref}'"; return 0; }
  note "both credentials name project '${db_ref}'"

  # ── Prove the credentials work before writing anything ──
  # A config written for an unreachable project is a timer that fails nightly.
  local err server_ver
  err="$(mktemp)"
  if ! server_ver="$(psql "$database_url" -Atc 'show server_version_num' 2>"$err")"; then
    local detail; detail="$(head -3 "$err" | tr '\n' ' ')"; rm -f "$err"
    emit "$id" failed "cannot connect to the database: ${detail}"; return 0
  fi
  rm -f "$err"
  note "connected to Postgres (server_version_num ${server_ver})"

  local server_major client_major
  server_major=$(( server_ver / 10000 ))
  client_major="$(pg_dump --version 2>/dev/null | awk '{print $3}' | cut -d. -f1)" || true
  [[ "$client_major" =~ ^[0-9]+$ ]] \
    || { emit "$id" failed "pg_dump is not installed on this host - apt-get install postgresql-client"; return 0; }
  if [ "$client_major" -lt "$server_major" ]; then
    emit "$id" failed "pg_dump is ${client_major}, the server is ${server_major}; install a matching postgresql-client"
    return 0
  fi
  note "pg_dump ${client_major} can dump a server ${server_major}"

  # What this credential can do, which is worth saying while it is being chosen.
  # A backup only reads; a role that can also write is one that could destroy
  # the project it protects, from a file sitting on this host.
  local writable total
  writable="$(psql "$database_url" -Atqc "select count(*) from pg_class c join pg_namespace n on n.oid = c.relnamespace where c.relkind in ('r','p') and n.nspname = 'public' and has_table_privilege(current_user, c.oid, 'INSERT, UPDATE, DELETE, TRUNCATE')" 2>/dev/null || echo "")"
  total="$(psql "$database_url" -Atqc "select count(*) from pg_class c join pg_namespace n on n.oid = c.relnamespace where c.relkind in ('r','p') and n.nspname = 'public'" 2>/dev/null || echo "")"
  if [[ "$writable" =~ ^[0-9]+$ && "$total" =~ ^[0-9]+$ ]]; then
    if [ "$writable" -eq 0 ]; then
      note "this role cannot write to any table in public - a stolen copy of it cannot destroy the project"
    else
      note "this role can write to ${writable} of ${total} table(s) in public, and a backup only ever reads. A read-only role would mean a stolen copy could not destroy the project - see the docs."
    fi
  fi

  # curl's own exit status matters as much as the HTTP code it reports. A
  # timeout or a DNS failure leaves the code at 000, and reading that as "the
  # key was rejected" sends someone to Supabase to reissue a key that was
  # always fine. Worse, before this was checked at all, a non-zero curl ended
  # the whole script under `set -e` and the console was told the helper was
  # not installed.
  # Supabase's current secret keys (sb_secret_...) are not JWTs, and the
  # API-keys guide is explicit: send publishable and secret keys on `apikey`,
  # not on `Authorization: Bearer`, because anything that tries to verify one
  # as a JWT fails. From storage that is an HTTP 400 naming neither the header
  # nor the key. A legacy service_role key is a JWT and still goes on both.
  local auth=(-H "apikey: ${service_key}")
  if [[ "$service_key" == eyJ* ]]; then
    auth=(-H "Authorization: Bearer ${service_key}" "${auth[@]}")
  fi

  # The body, not just the code. Storage says why in it - "Invalid JWT", "Bucket
  # not found" - and an HTTP number on its own has sent people to reissue a key
  # that was never the problem.
  local body said
  body="$(mktemp)"

  local code rc=0
  code="$(curl -s -o "$body" -w '%{http_code}' --max-time 20 \
        "${supabase_url}/storage/v1/bucket" "${auth[@]}")" || rc=$?
  if [ "$rc" -ne 0 ]; then
    rm -f "$body"
    local why="curl exit ${rc}"
    case "$rc" in
      6)     why="this host cannot resolve that name" ;;
      7)     why="the connection was refused" ;;
      28)    why="it did not answer within 20s" ;;
      35|60) why="the TLS handshake failed" ;;
      127)   why="curl is not installed on this host" ;;
    esac
    emit "$id" failed "could not reach ${supabase_url} to check the service key: ${why}. The key itself may be fine - nothing was registered, so this can be retried."
    return 0
  fi
  if [ "$code" != "200" ]; then
    said="$(jq -r '[.error? // empty, .message? // empty]
                   | map(select(type == "string" and length > 0)) | unique | join(" - ")' \
            < "$body" 2>/dev/null)" || said=""
    [ -n "$said" ] || said="$(head -c 200 "$body" | tr -d '\n')"
    # It should never be in there, but a body is not ours to vouch for.
    said="${said//"$service_key"/<the key>}"
    rm -f "$body"
    emit "$id" failed "the service key was rejected by storage (HTTP ${code}${said:+: ${said}})"
    return 0
  fi
  rm -f "$body"
  note "service key accepted by the storage API"

  # ── Write the config ──
  umask 077
  # Claimed before the first byte, so a write that dies partway still leaves
  # something undo_partial knows to remove.
  PARTIAL_CONF="${CONF_DIR}/${project}.conf"
  cat > "${CONF_DIR}/${project}.conf" <<EOF
# supabase-backup config for '${project}'
# Registered from the web console. Contains a service key that bypasses RLS
# and a database password: keep this file 0600 and out of version control.
DATABASE_URL=${database_url}
SUPABASE_URL=${supabase_url}
SUPABASE_SERVICE_KEY=${service_key}
BACKUP_DIR=${DATA_DIR}/${project}
KEEP_DAYS=${keep_days}
EOF
  chmod 0600 "${CONF_DIR}/${project}.conf"
  note "wrote ${CONF_DIR}/${project}.conf, mode 0600"

  # Group-readable from the start, so the console can see this project's
  # archives without anyone re-running the setup script.
  install -d -m 0750 -g "$WEB_USER" "${DATA_DIR}/${project}" 2>/dev/null \
    || { undo_partial
         emit "$id" failed "could not create ${DATA_DIR}/${project} - is there a '${WEB_USER}' group on this host?"
         return 0; }
  PARTIAL_DIR="${DATA_DIR}/${project}"
  note "created ${DATA_DIR}/${project}, readable by ${WEB_USER}"

  systemctl enable --now "supabase-backup@${project}.timer" >/dev/null 2>&1 \
    || { undo_partial
         emit "$id" failed "could not enable supabase-backup@${project}.timer - journalctl -u supabase-backup-register has the reason"
         return 0; }
  note "nightly timer enabled"

  if [ "$run_now" = "true" ]; then
    systemctl start --no-block "supabase-backup@${project}.service" \
      && note "first backup started - watch it in the run history"
  fi

  # Registered. What was partial is now the project, and undoing it is no
  # longer this script's business.
  PARTIAL_CONF=""; PARTIAL_DIR=""
  emit "$id" ok ""
}

case "${1:-}" in
  --drain|"")
    shopt -s nullglob
    for f in "$REG_DIR"/*.json; do process "$f"; done
    ;;
  *) process "$1" ;;
esac
