#!/bin/bash
# upgrade — bring this host's supabase-backup installation up to date.
#
#   upgrade                    say what is available, then ask before applying
#   upgrade --check            say what is available and stop
#   upgrade --check --json     the same, for the console
#   upgrade --apply            apply without asking
#   upgrade --drain            apply every pending request (what the .path unit runs)
#
# Re-running the setup script also updates the code, but it is an installer: it
# asks the questions an installer asks, and answering one of them differently
# by accident changes the host. This only replaces code — never a config, never
# a credential, never an archive — and it can be driven from the console.
#
# What "up to date" means here is the commit that last touched
# scripts/supabase-backup on the branch this host installs from, recorded at
# install time and compared against what GitHub reports now. VERSION is the
# name a human reads; the commit is what decides, because a version string is
# only as honest as whoever remembered to bump it. When GitHub's API cannot be
# reached the two version strings are compared instead, and the check says so
# rather than quietly answering a smaller question.
#
# Nothing installed here is taken from a request. --drain reads an id and a
# verb and no more: every URL is fixed in this file, so a console that has been
# talked into asking for an upgrade can still only ask for this one.

set -euo pipefail

export LC_ALL=C.UTF-8 LANG=C.UTF-8

# ── Where the code comes from ────────────────────────────────────────────────
GITHUB_USER="${GITHUB_USER:-maggifrank}"
GITHUB_REPO="${GITHUB_REPO:-scripts}"
BRANCH="${BRANCH:-main}"
REPO_PATH="scripts/supabase-backup"
RAW_BASE="https://raw.githubusercontent.com/${GITHUB_USER}/${GITHUB_REPO}/${BRANCH}/${REPO_PATH}"
API_BASE="https://api.github.com/repos/${GITHUB_USER}/${GITHUB_REPO}"

LIB_DIR="${LIB_DIR:-/opt/supabase-backup}"
WEB_DIR="${LIB_DIR}/web"
UNIT_DIR="${UNIT_DIR:-/etc/systemd/system}"
TMPFILES="/etc/tmpfiles.d/supabase-backup-web.conf"
STATE_FILE="${LIB_DIR}/installed.json"
ROLLBACK_DIR="${ROLLBACK_DIR:-/var/lib/supabase-backup/rollback}"
ROLLBACK_KEEP=5

SPOOL_DIR="${SPOOL_DIR:-/run/supabase-backup-web}"
UPGRADE_SPOOL="${SPOOL_DIR}/upgrade"
RES_DIR="${SPOOL_DIR}/results"
WEB_USER="${WEB_USER:-supabase-backup-web}"
WEB_UNIT="${WEB_UNIT:-supabase-backup-web.service}"

# A check goes to the network, and the console asks every time the settings
# panel opens. Answer from the last one for this long. The console overrides
# the path because it cannot write the default one; where neither is writable
# the check still works and simply does not cache.
CACHE_FILE="${UPGRADE_CACHE:-/var/lib/supabase-backup/upgrade-check.json}"
CACHE_TTL="${UPGRADE_CACHE_TTL:-21600}"       # 6 hours

# ── Colors, only at a terminal ───────────────────────────────────────────────
if [ -t 1 ]; then
  RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'
  BLUE=$'\033[0;34m'; BOLD=$'\033[1m'; NC=$'\033[0m'
else
  RED=""; GREEN=""; YELLOW=""; BLUE=""; BOLD=""; NC=""
fi
info() { echo "${GREEN}[INFO]${NC}  $1"; }
warn() { echo "${YELLOW}[WARN]${NC}  $1"; }
fail() { echo "${RED}[ERROR]${NC} $1" >&2; exit 1; }
step() { echo; echo "${BLUE}──── $1 ────${NC}"; }

# Steps are collected either way: printed at a terminal, and handed back in the
# result file when the console asked.
QUIET=""
STEPS=()
note() { STEPS+=("$1"); [ -n "$QUIET" ] || printf '  %s\n' "$1"; }

# ── What an installation is made of ──────────────────────────────────────────
# "<path under RAW_BASE>|<destination>|<mode>". Both halves are written here,
# so no path in an upgrade can come from anywhere else.
#
# Not in either list: /etc/supabase-backup, /etc/supabase-backup-web and
# web.env.example. An upgrade that could rewrite a config could undo a decision
# someone made deliberately — which password, which address, whether restores
# are allowed. Archives are not here for a shorter reason.

CORE_FILES=(
  "backup.sh|${LIB_DIR}/backup.sh|0755"
  "catalog.sql|${LIB_DIR}/catalog.sql|0644"
  "restore|${LIB_DIR}/restore|0755"
  "upgrade|${LIB_DIR}/upgrade|0755"
  "VERSION|${LIB_DIR}/VERSION|0644"
  "supabase-backup@.service|${UNIT_DIR}/supabase-backup@.service|0644"
  "supabase-backup@.timer|${UNIT_DIR}/supabase-backup@.timer|0644"
)

WEB_FILES=(
  "register|${LIB_DIR}/register|0755"
  "reconfigure|${LIB_DIR}/reconfigure|0755"
  "keys|${LIB_DIR}/keys|0755"
  "web/server.py|${WEB_DIR}/server.py|0755"
  "web/static/index.html|${WEB_DIR}/static/index.html|0644"
  "web/static/app.js|${WEB_DIR}/static/app.js|0644"
  "web/static/style.css|${WEB_DIR}/static/style.css|0644"
  "web/static/favicon.svg|${WEB_DIR}/static/favicon.svg|0644"
  "supabase-backup-web.service|${UNIT_DIR}/supabase-backup-web.service|0644"
  "supabase-backup-register.path|${UNIT_DIR}/supabase-backup-register.path|0644"
  "supabase-backup-register.service|${UNIT_DIR}/supabase-backup-register.service|0644"
  "supabase-backup-reconfigure.path|${UNIT_DIR}/supabase-backup-reconfigure.path|0644"
  "supabase-backup-reconfigure.service|${UNIT_DIR}/supabase-backup-reconfigure.service|0644"
  "supabase-backup-keys.path|${UNIT_DIR}/supabase-backup-keys.path|0644"
  "supabase-backup-keys.service|${UNIT_DIR}/supabase-backup-keys.service|0644"
  "supabase-backup-restore.path|${UNIT_DIR}/supabase-backup-restore.path|0644"
  "supabase-backup-restore.service|${UNIT_DIR}/supabase-backup-restore.service|0644"
  "supabase-backup-upgrade.path|${UNIT_DIR}/supabase-backup-upgrade.path|0644"
  "supabase-backup-upgrade.service|${UNIT_DIR}/supabase-backup-upgrade.service|0644"
  "supabase-backup-web.tmpfiles|${TMPFILES}|0644"
)

# The console half is optional: a host can back up without ever serving a page.
web_installed() { [ -f "${WEB_DIR}/server.py" ]; }

payload() {
  printf '%s\n' "${CORE_FILES[@]}"
  if web_installed; then printf '%s\n' "${WEB_FILES[@]}"; fi
}

components() {
  if web_installed; then echo "core web"; else echo "core"; fi
}

# ── What is installed ────────────────────────────────────────────────────────

installed_json() {
  # installed.json is written by the setup scripts and by this one. An
  # installation predating all of that has neither a commit nor a date, and
  # says so: "unknown" is a true answer where a version number would not be.
  if [ -f "$STATE_FILE" ] && jq -e . "$STATE_FILE" >/dev/null 2>&1; then
    cat "$STATE_FILE"
    return 0
  fi
  local version=""
  if [ -f "${LIB_DIR}/VERSION" ]; then
    version="$(tr -d '[:space:]' < "${LIB_DIR}/VERSION")"
  fi
  jq -nc --arg v "$version" --arg comp "$(components)" \
     '{version:$v, commit:"", installed_at:"", components:($comp|split(" "))}'
}

write_installed() {  # write_installed <version> <commit>
  local tmp
  tmp="$(mktemp)"
  jq -nc --arg v "$1" --arg c "$2" \
     --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg comp "$(components)" \
     --arg repo "${GITHUB_USER}/${GITHUB_REPO}" --arg branch "$BRANCH" \
     '{version:$v, commit:$c, installed_at:$at, components:($comp|split(" ")),
       repo:$repo, branch:$branch}' > "$tmp"
  install -m 0644 "$tmp" "$STATE_FILE"
  rm -f "$tmp"
}

# ── What is available ────────────────────────────────────────────────────────

remote_version() {
  curl -fsSL --max-time 20 "${RAW_BASE}/VERSION" 2>/dev/null | tr -d '[:space:]'
}

remote_commit() {  # "<sha> <iso date>", or nothing
  # The last commit that touched the directory this host installs from. Asking
  # about the whole branch would report an upgrade every time some unrelated
  # script in the repo changed, and installing it would replace nothing.
  curl -fsSL --max-time 20 -H 'Accept: application/vnd.github+json' \
    "${API_BASE}/commits?sha=${BRANCH}&path=${REPO_PATH}&per_page=1" 2>/dev/null \
    | jq -r 'if type=="array" and length>0
             then "\(.[0].sha) \(.[0].commit.committer.date)" else empty end' 2>/dev/null
}

cache_read() {
  [ -f "$CACHE_FILE" ] || return 1
  local now then_ age cached_commit live_commit
  now="$(date -u +%s)"
  then_="$(jq -r '.checked_at_epoch // 0' "$CACHE_FILE" 2>/dev/null)" || return 1
  [[ "$then_" =~ ^[0-9]+$ ]] || return 1
  age=$(( now - then_ ))
  [ "$age" -ge 0 ] && [ "$age" -lt "$CACHE_TTL" ] || return 1
  # A cached answer describes an installation. If this host has been upgraded
  # since — or changed by hand — the cache is an answer about someone else.
  cached_commit="$(jq -r '.installed.commit // ""' "$CACHE_FILE" 2>/dev/null)"
  live_commit="$(installed_json | jq -r '.commit // ""')"
  [ "$cached_commit" = "$live_commit" ] || return 1
  cat "$CACHE_FILE"
}

cache_write() {
  local dir
  dir="$(dirname "$CACHE_FILE")"
  mkdir -p "$dir" 2>/dev/null || return 0
  if printf '%s\n' "$1" > "${CACHE_FILE}.tmp" 2>/dev/null; then
    chmod 0644 "${CACHE_FILE}.tmp" 2>/dev/null || true
    mv -f "${CACHE_FILE}.tmp" "$CACHE_FILE" 2>/dev/null || rm -f "${CACHE_FILE}.tmp"
  fi
  return 0
}

check() {  # check [--refresh] -> one JSON object on stdout
  if [ "${1:-}" != "--refresh" ]; then
    local cached
    if cached="$(cache_read)"; then printf '%s\n' "$cached"; return 0; fi
  fi

  local inst avail_version commit_line avail_commit avail_date error=""
  inst="$(installed_json)"
  avail_version="$(remote_version)" || true
  commit_line="$(remote_commit)" || true
  avail_commit="${commit_line%% *}"
  if [ -n "$commit_line" ] && [ "$avail_commit" != "$commit_line" ]; then
    avail_date="${commit_line#* }"
  else
    avail_date=""
  fi

  local have_commit have_version
  have_commit="$(jq -r '.commit  // ""' <<<"$inst")"
  have_version="$(jq -r '.version // ""' <<<"$inst")"

  # Three ways to answer, in descending order of how much they actually know.
  local available=false basis reason
  if [ -n "$avail_commit" ] && [ -n "$have_commit" ]; then
    basis="commit"
    if [ "$avail_commit" = "$have_commit" ]; then
      reason="running the commit GitHub last published for ${REPO_PATH}"
    else
      available=true
      reason="${have_commit:0:7} → ${avail_commit:0:7}"
    fi
  elif [ -n "$avail_version" ] && [ -n "$have_version" ]; then
    basis="version"
    if [ "$avail_version" = "$have_version" ]; then
      reason="version ${have_version}, and GitHub publishes the same one. The commit could not be read, so a change that did not bump VERSION would not show here."
    else
      available=true
      reason="${have_version} → ${avail_version}"
    fi
  elif [ -z "$avail_version" ] && [ -z "$avail_commit" ]; then
    basis="none"
    error="could not reach GitHub — neither a version nor a commit came back"
    reason="$error"
  else
    # Something is published, nothing is recorded here: an installation from
    # before any of this existed. Upgrading is how it gets a record.
    basis="unrecorded"
    available=true
    reason="this installation has no recorded version, so what it is running cannot be compared"
  fi

  local body
  body="$(jq -nc \
    --argjson installed "$inst" \
    --arg av "$avail_version" --arg ac "$avail_commit" --arg ad "$avail_date" \
    --argjson up "$available" --arg basis "$basis" --arg reason "$reason" \
    --arg error "$error" --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --argjson epoch "$(date -u +%s)" --arg comp "$(components)" \
    --arg repo "${GITHUB_USER}/${GITHUB_REPO}" --arg branch "$BRANCH" \
    '{installed: ($installed + {components: ($comp|split(" "))}),
      available: {version:$av, commit:$ac, committed_at:$ad},
      upgrade_available:$up, basis:$basis, reason:$reason, error:$error,
      repo:$repo, branch:$branch, checked_at:$at, checked_at_epoch:$epoch}')"
  cache_write "$body"
  printf '%s\n' "$body"
}

print_check() {  # print_check <json>
  local j="$1" hv hc hat av ac line
  hv="$(jq -r '.installed.version // ""'      <<<"$j")"
  hc="$(jq -r '.installed.commit  // ""'      <<<"$j")"
  hat="$(jq -r '.installed.installed_at // ""' <<<"$j")"
  av="$(jq -r '.available.version // ""'      <<<"$j")"
  ac="$(jq -r '.available.commit  // ""'      <<<"$j")"

  line="${hv:-unknown}"
  [ -n "$hc" ]  && line="${line} · ${hc:0:7}"
  [ -n "$hat" ] && line="${line} · installed ${hat}"
  printf '  %-11s %s\n' "Running" "$line"
  line="${av:-unknown}"
  [ -n "$ac" ] && line="${line} · ${ac:0:7}"
  printf '  %-11s %s\n' "Available" "$line"
  printf '  %-11s %s\n' "Installed" "$(jq -r '.installed.components | join(", ")' <<<"$j")"
  echo
  if [ -n "$(jq -r '.error // ""' <<<"$j")" ]; then
    warn "$(jq -r '.error' <<<"$j")"
  elif [ "$(jq -r '.upgrade_available' <<<"$j")" = "true" ]; then
    info "an upgrade is available — $(jq -r '.reason' <<<"$j")"
  else
    info "up to date — $(jq -r '.reason' <<<"$j")"
  fi
}

# ── Applying ─────────────────────────────────────────────────────────────────

busy_units() {
  # A backup writing a tarball, or a restore writing a live project. Replacing
  # the code underneath either is not something to do because a button was
  # convenient. systemd is asked directly: the console's view of this is a page
  # that may be minutes old.
  systemctl list-units --state=active --plain --no-legend \
    'supabase-backup@*.service' 'supabase-backup-restore.service' 2>/dev/null \
    | awk '{print $1}'
}

stage() {  # stage <dir> — the whole payload, or a failure having changed nothing
  local dir="$1" entry src dest mode target err
  while IFS= read -r entry; do
    [ -n "$entry" ] || continue
    src="${entry%%|*}"; entry="${entry#*|}"
    dest="${entry%%|*}"; mode="${entry##*|}"
    target="${dir}/$(printf '%s' "$src" | tr '/' '_')"
    # curl's own message says which half of "could not download" it was - no
    # route, no such file, TLS - and that is the whole difference between
    # "GitHub is down" and "this release is not published yet".
    err="$(curl -fsSL --max-time 60 "${RAW_BASE}/${src}" -o "$target" 2>&1)" \
      || { echo "could not download ${src}${err:+: ${err}}" >&2; return 1; }
    [ -s "$target" ] || { echo "${src} came back empty" >&2; return 1; }
    chmod "$mode" "$target"
    printf '%s\t%s\t%s\n' "$target" "$dest" "$mode"
  done < <(payload)
}

sanity() {  # sanity <plan> — refuse to install something obviously broken
  local target dest mode base
  while IFS=$'\t' read -r target dest mode; do
    base="$(basename "$dest")"
    case "$base" in
      *.sh|restore|register|reconfigure|keys|upgrade)
        head -1 "$target" | grep -q '^#!' \
          || { echo "${base} does not start with a #! line"; return 1; }
        bash -n "$target" 2>/dev/null || { echo "${base} is not valid bash"; return 1; }
        ;;
      server.py)
        head -1 "$target" | grep -q '^#!' \
          || { echo "server.py does not start with a #! line"; return 1; }
        python3 -m py_compile "$target" 2>/dev/null \
          || { echo "server.py does not compile"; return 1; }
        ;;
      *.service|*.timer|*.path)
        grep -q '^\[Unit\]' "$target" || { echo "${base} is not a unit file"; return 1; }
        ;;
    esac
  done < "$1"
  return 0
}

# What is here now, so it can be put back. A file the upgrade is about to
# create for the first time is recorded as absent rather than skipped: rolling
# back has to remove it, or a half-applied release leaves units behind.
save_rollback() {  # save_rollback <plan> <dir>
  local dir="$2" target dest mode
  install -d -m 0700 "$dir" || return 1
  : > "${dir}/state.tsv" || return 1
  while IFS=$'\t' read -r target dest mode; do
    if [ -f "$dest" ]; then
      install -d -m 0700 "$(dirname "${dir}${dest}")" || return 1
      install -m 0600 "$dest" "${dir}${dest}" || return 1
      printf '%s\t%s\n' "$dest" "$(stat -c '%a' "$dest")" >> "${dir}/state.tsv" || return 1
    else
      printf '%s\tABSENT\n' "$dest" >> "${dir}/state.tsv" || return 1
    fi
  done < "$1"
}

restore_rollback() {  # restore_rollback <dir>
  local dir="$1" dest mode
  while IFS=$'\t' read -r dest mode; do
    if [ "$mode" = "ABSENT" ]; then
      rm -f "$dest"
    elif [ -f "${dir}${dest}" ]; then
      install -m "$mode" "${dir}${dest}" "$dest"
    fi
  done < "${dir}/state.tsv"
  systemctl daemon-reload >/dev/null 2>&1 || true
}

prune_rollbacks() {
  local old
  old="$(find "$ROLLBACK_DIR" -mindepth 1 -maxdepth 1 -type d 2>/dev/null \
         | sort -r | tail -n +$((ROLLBACK_KEEP + 1)))"
  if [ -n "$old" ]; then printf '%s\n' "$old" | xargs -r rm -rf; fi
  return 0
}

apply_body() {  # apply_body <staging> <force>
  local staging="$1" force="$2" plan="$1/plan.tsv" problem

  local busy
  busy="$(busy_units)"
  if [ -n "$busy" ] && [ "$force" != "1" ]; then
    note "refused — $(printf '%s' "$busy" | tr '\n' ' ')is running"
    APPLY_ERROR="a backup or a restore is running on this host. Upgrading now would replace the code underneath it. Try again when it has finished."
    return 1
  fi

  # stdout is the plan, stderr is why it stopped. Flattened, because it ends up
  # in one line of a result box in the browser.
  if ! problem="$(stage "$staging" 2>&1 > "$plan")"; then
    problem="$(printf '%s' "$problem" | tr '\n' ' ')"
    APPLY_ERROR="${problem:-the download failed}. Nothing has been changed."
    note "download failed — nothing changed"
    return 1
  fi
  note "downloaded $(wc -l < "$plan" | tr -d ' ') files from ${RAW_BASE}"

  if ! problem="$(sanity "$plan")"; then
    APPLY_ERROR="${problem}. Nothing has been changed."
    note "what came back did not check out — nothing changed"
    return 1
  fi
  note "every file parses as what it claims to be"

  local was_active=0
  if systemctl is-active --quiet "$WEB_UNIT" 2>/dev/null; then was_active=1; fi

  local stamp rollback
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  rollback="${ROLLBACK_DIR}/${stamp}"
  install -d -m 0700 "$ROLLBACK_DIR"
  # Never install without one. A rollback that could not be taken is not a
  # detail to note and carry on from: it is the difference between a failed
  # upgrade and a host with no console and no way back to the one it had.
  if ! save_rollback "$plan" "$rollback"; then
    rm -rf "$rollback"
    note "could not keep a copy of what is installed — nothing changed"
    APPLY_ERROR="could not copy the current files to ${rollback}, so there would be nothing to put back if the new code did not work. Nothing has been changed."
    return 1
  fi
  note "kept what is here now under ${rollback}"

  # install(1), never cp: it replaces the directory entry with a new inode, so
  # a backup.sh running right now — and this script, which is in the payload —
  # keeps reading the file it started from.
  #
  # Every install is checked. errexit is off inside a function called from an
  # `if`, which this is, so nothing else here would notice a half-written
  # /opt — and a half-written /opt is the one state this whole design exists
  # to avoid being left in.
  local target dest mode changed=0 broke=""
  while IFS=$'\t' read -r target dest mode; do
    if ! install -d -m 0755 "$(dirname "$dest")"; then broke="$dest"; break; fi
    if [ -f "$dest" ] && cmp -s "$target" "$dest"; then continue; fi
    if ! install -m "$mode" "$target" "$dest"; then broke="$dest"; break; fi
    changed=$((changed + 1))
  done < "$plan"
  if [ -n "$broke" ]; then
    restore_rollback "$rollback"
    note "could not write ${broke} — every file has been put back as it was"
    APPLY_ERROR="could not write ${broke}. Nothing was left half-installed: the previous files are back."
    return 1
  fi
  if [ "$changed" -eq 0 ]; then
    note "no file differed — nothing was replaced"
  else
    note "${changed} file(s) replaced"
  fi

  ln -sf "${LIB_DIR}/restore" /usr/local/bin/supabase-restore \
    || note "could not link /usr/local/bin/supabase-restore"
  ln -sf "${LIB_DIR}/upgrade" /usr/local/bin/supabase-backup-upgrade \
    || note "could not link /usr/local/bin/supabase-backup-upgrade"

  systemctl daemon-reload || note "systemctl daemon-reload reported a problem"
  if web_installed && [ -f "$TMPFILES" ]; then
    systemd-tmpfiles --create "$TMPFILES" >/dev/null 2>&1 \
      || note "systemd-tmpfiles could not create the spool directories"
    # A release can add a spool, and a .path unit with nothing to watch never
    # fires. supabase-backup-restore.path is deliberately not in this list:
    # whether this host acts on a restore request is a decision someone made
    # at the setup script, and an upgrade is not the place to revisit it.
    local unit
    for unit in supabase-backup-register.path supabase-backup-reconfigure.path \
                supabase-backup-keys.path supabase-backup-upgrade.path; do
      systemctl enable --now "$unit" >/dev/null 2>&1 || true
    done
    note "helpers reloaded and watching their spools"
  fi

  if [ "$was_active" -eq 1 ]; then
    local up=0 i
    if systemctl restart "$WEB_UNIT" >/dev/null 2>&1; then
      # Type=exec returns as soon as the process is running, and a console that
      # cannot parse its own config dies a moment later. Ask again.
      for i in 1 2 3; do
        sleep 1
        if systemctl is-active --quiet "$WEB_UNIT"; then up=1; else up=0; break; fi
      done
    fi
    if [ "$up" -eq 0 ]; then
      local why
      why="$(journalctl -u "$WEB_UNIT" -n 8 --no-pager -o cat 2>/dev/null \
             | tr '\n' ' ' | tail -c 300)"
      restore_rollback "$rollback"
      systemctl restart "$WEB_UNIT" >/dev/null 2>&1 || true
      note "the console did not come back — every file has been put back as it was"
      APPLY_ERROR="the new console would not start, so the upgrade was rolled back: ${why}"
      return 1
    fi
    note "${WEB_UNIT} restarted and running"
  fi

  local new_version new_commit
  new_version="$(tr -d '[:space:]' < "${LIB_DIR}/VERSION" 2>/dev/null || true)"
  new_commit="${AVAILABLE_COMMIT:-}"
  if [ -z "$new_commit" ]; then new_commit="$(remote_commit | cut -d' ' -f1)"; fi
  write_installed "$new_version" "$new_commit"
  # The console keeps its own cache under its state directory; that one is
  # invalidated by the recorded commit changing, which it just did.
  rm -f "$CACHE_FILE" 2>/dev/null || true
  local said="now running ${new_version:-unknown}"
  [ -n "$new_commit" ] && said="${said} · ${new_commit:0:7}"
  note "$said"

  prune_rollbacks
  return 0
}

# Staging lives here rather than in apply_body so it is cleaned up whichever
# way that returns. Note that errexit is already off inside apply_body: bash
# disables it for a function called as an `if` condition, which is how both
# callers call this. Everything in there that matters is checked by hand.
apply() {  # apply <force>
  local staging status
  staging="$(mktemp -d)"
  apply_body "$staging" "$1" && status=0 || status=$?
  rm -rf "$staging"
  return "$status"
}

# ── The spool, for the console's Upgrade button ──────────────────────────────
# The same shape as every other privileged thing here: the console leaves a
# request, this reads it. A request carries an id and the one verb this
# accepts, and nothing else: no version to choose and no URL to supply, so a
# request that was tampered with on the way asks for exactly what an
# untampered one asks for.

emit() {  # emit <id> <state> <error> [extra json object]
  local id="$1" state="$2" error="${3:-}" extras="${4:-}"
  [ -n "$extras" ] || extras='{}'
  mkdir -p "$RES_DIR"
  jq -nc --arg id "$id" --arg state "$state" --arg error "$error" \
     --arg kind upgrade --arg finished "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
     --argjson extras "$extras" \
     --argjson steps "$(printf '%s\n' "${STEPS[@]:-}" | jq -R -s 'split("\n") | map(select(length>0))')" \
     '{id:$id, kind:$kind, state:$state, error:$error, steps:$steps, finished_at:$finished} + $extras' \
     > "${RES_DIR}/${id}.json.tmp"
  chmod 0640 "${RES_DIR}/${id}.json.tmp"
  chgrp "$WEB_USER" "${RES_DIR}/${id}.json.tmp" 2>/dev/null || true
  mv -f "${RES_DIR}/${id}.json.tmp" "${RES_DIR}/${id}.json"
}

process() {
  local file="$1" id body action j
  STEPS=()
  QUIET=1

  id="$(basename "$file" .json)"
  [[ "$id" =~ ^[0-9a-f]{32}$ ]] || { rm -f "$file"; return 0; }

  body="$(cat "$file")" || { emit "$id" failed "could not read the request"; rm -f "$file"; return 0; }
  # Removing it is what re-arms the .path unit. Nothing in one is secret, so
  # there is nothing to shred.
  rm -f "$file"

  # Claim the id before the work starts. Without this the console polls an id
  # with neither a request nor a result, which reads as "no result came back"
  # while the download is still going.
  emit "$id" running ""

  # One verb. A request to *check* would come through here too, and its result
  # would be indistinguishable from an upgrade that installed nothing - so the
  # console does its own checking, which needs no privilege at all, and this
  # spool means one thing.
  action="$(jq -r '.action // "apply"' <<<"$body")"
  case "$action" in
    apply)
      j="$(check --refresh)"
      AVAILABLE_COMMIT="$(jq -r '.available.commit // ""' <<<"$j")"
      APPLY_ERROR=""
      if apply 0; then
        emit "$id" ok "" "$(jq -c '{check: .}' <<<"$(check --refresh)")"
      else
        emit "$id" failed "${APPLY_ERROR:-the upgrade failed}"
      fi
      ;;
    *)
      emit "$id" failed "the request does not name something this helper does"
      ;;
  esac
}

drain() {
  shopt -s nullglob
  local f
  for f in "$UPGRADE_SPOOL"/*.json; do process "$f"; done
}

# ── Entry ────────────────────────────────────────────────────────────────────

usage() {
  cat <<'USAGE'
upgrade — bring this host's supabase-backup installation up to date.

  upgrade                 say what is available, then ask before applying
  upgrade --check         say what is available and stop
  upgrade --check --json  the same, as JSON (what the console reads)
  upgrade --apply         apply without asking
  upgrade --drain         apply pending requests from the console's spool
  upgrade --record        record what is installed right now (the setup scripts)
  upgrade --version       print the installed version

  --refresh   ignore the cached check and ask GitHub again
  --force     upgrade even while a backup or restore is running

Replaces only code: /opt/supabase-backup, the systemd units, and the console's
static files. Never a config, never a credential, never an archive, and never
whether this host acts on a restore request.
USAGE
}

need_root() { [ "$(id -u)" -eq 0 ] || fail "this must be run as root"; }

JSON=0
REFRESH=""
MODE="interactive"
FORCE=0
AVAILABLE_COMMIT=""
APPLY_ERROR=""

while [ $# -gt 0 ]; do
  case "$1" in
    --check)    MODE="check" ;;
    --apply|-y) MODE="apply" ;;
    --drain)    MODE="drain" ;;
    --json)     JSON=1 ;;
    --refresh)  REFRESH="--refresh" ;;
    --force)    FORCE=1 ;;
    --record)   MODE="record" ;;
    --version)  MODE="version" ;;
    -h|--help)  usage; exit 0 ;;
    *) fail "unknown option: $1" ;;
  esac
  shift
done

# Checked after the loop rather than before it, so --help still answers on a
# host that has neither.
command -v jq   >/dev/null || fail "jq is not installed"
command -v curl >/dev/null || fail "curl is not installed"

case "$MODE" in
  version)
    installed_json | jq -r 'if (.version // "") == "" then "unknown" else .version end'
    ;;

  check)
    RESULT="$(check $REFRESH)"
    if [ "$JSON" -eq 1 ]; then
      printf '%s\n' "$RESULT"
    else
      echo; echo "${BOLD}supabase-backup${NC}"; echo
      print_check "$RESULT"
      if [ "$(jq -r '.upgrade_available' <<<"$RESULT")" = "true" ]; then
        echo; echo "  Upgrade with  supabase-backup-upgrade"
      fi
      echo
    fi
    ;;

  record)
    # What the setup scripts call once they have put the files in place. They
    # download the same payload this script would, so the only thing missing
    # afterwards is the record of which commit it was - and that lives here,
    # with everything else that knows what a version is.
    need_root
    RECORD_VERSION=""
    if [ -f "${LIB_DIR}/VERSION" ]; then
      RECORD_VERSION="$(tr -d '[:space:]' < "${LIB_DIR}/VERSION")"
    fi
    write_installed "$RECORD_VERSION" "$(remote_commit | cut -d' ' -f1)"
    rm -f "$CACHE_FILE" 2>/dev/null || true
    installed_json | jq -r '"\(.version // "unknown") · \(.commit[0:7] // "")"'
    ;;

  drain)
    need_root
    drain
    ;;

  apply)
    need_root
    RESULT="$(check --refresh)"
    AVAILABLE_COMMIT="$(jq -r '.available.commit // ""' <<<"$RESULT")"
    step "Upgrading"
    if apply "$FORCE"; then info "done"; else fail "$APPLY_ERROR"; fi
    ;;

  interactive)
    need_root
    [ ! -t 0 ] && exec < /dev/tty
    echo
    echo "${BOLD}supabase-backup — upgrade${NC}"
    echo
    echo "  Replaces the code this host runs with what ${GITHUB_USER}/${GITHUB_REPO}"
    echo "  publishes on ${BRANCH}. Configs, credentials and archives are not touched,"
    echo "  and neither is whether this host acts on a restore request."
    echo
    RESULT="$(check --refresh)"
    print_check "$RESULT"
    AVAILABLE_COMMIT="$(jq -r '.available.commit // ""' <<<"$RESULT")"
    echo
    if [ "$(jq -r '.upgrade_available' <<<"$RESULT")" = "true" ] || [ "$FORCE" -eq 1 ]; then
      read -rp "  Upgrade now? [y/N]: " ANSWER
      [[ "$ANSWER" =~ ^[Yy]$ ]] || { echo "  Aborted."; exit 0; }
    else
      read -rp "  Reinstall the current version anyway? [y/N]: " ANSWER
      [[ "$ANSWER" =~ ^[Yy]$ ]] || { echo "  Nothing to do."; exit 0; }
    fi
    step "Upgrading"
    if apply "$FORCE"; then
      echo
      info "done"
      echo
      echo "  What changed  https://github.com/${GITHUB_USER}/${GITHUB_REPO}/commits/${BRANCH}/${REPO_PATH}"
      echo
    else
      fail "$APPLY_ERROR"
    fi
    ;;
esac
